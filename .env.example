# Kilo Gateway is the default provider.
AI_PROVIDER=kilo
KILO_API_KEY="YOUR_KILO_API_KEY"
AI_MODEL="openai/gpt-5.4-mini"

# For OpenAI directly, use these instead:
# AI_PROVIDER=openai
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# AI_MODEL="gpt-5.4-mini"

# For another OpenAI-compatible API, set its URL and key:
# AI_BASE_URL="https://your-provider.example/v1"
# AI_API_KEY="YOUR_PROVIDER_API_KEY"
# AI_MODEL="provider/model-name"

# APP_URL: Optional URL where this app is hosted.
APP_URL="MY_APP_URL"
